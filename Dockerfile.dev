# Desarrollo local con proxy - sirve la app en desarrollo
FROM node:22-alpine

# Configurar proxy
ENV HTTP_PROXY=http://172.16.65.61:3128
ENV HTTPS_PROXY=http://172.16.65.61:3128
ENV NO_PROXY=localhost,127.0.0.1,::1

WORKDIR /app

# Copiar package.json
COPY package.json ./

# Instalar dependencias (puede tardar un tiempo por el proxy)
RUN yarn install --network-timeout 1200000

# Copiar el resto del código
COPY . .

# Exponer puerto de desarrollo (Vite default 5173)
EXPOSE 5173

# Iniciar servidor de desarrollo
CMD ["yarn", "dev", "--host", "0.0.0.0"]