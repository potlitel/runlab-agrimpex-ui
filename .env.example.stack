# =====================================================================
#  Plantilla de variables para docker compose (repo runlab-agrimpex-ui/)
#  Copiar a ".env":  cp .env.example.stack .env
#  Ojo: existe otro .env.example (solo VITE_*) para el dev local de Vite.
# =====================================================================

# --- Puertos publicados en el host ---
API_PORT=3001
# 3000 ya lo ocupa el stack DAM de referencia; usamos 3002 para esta UI.
UI_PORT=3002

# --- URLs que consume el NAVEGADOR (fallback del bundle de Vite) ---
# ⚠️ Dev local: localhost. Servidor remoto: http://<IP-del-servidor>:3001
# Estas dos claves se pueden cambiar desde Ajustes > Stack sin rebuild: la API
# publica public/public-config.json y la UI lo lee al arrancar. El valor de
# abajo solo se usa si ese recurso no responde.
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001

# --- Backend ---
# Base de la imagen de la API. node:22-alpine ya está descargada y basta
# para el dashboard. Solo cambiar si quieres ejecutar Playwright dentro
# del contenedor (requiere descargar esa imagen):
# API_BASE_IMAGE=mcr.microsoft.com/playwright:v1.62.1-noble
TZ=America/Argentina/Buenos_Aires
RUNLABQA_NOVNC_HOST=host.docker.internal
RUNLABQA_NOVNC_PORT=7900
# Habilita /api/system/update y la administración de Ajustes > Stack (fail closed).
# Sin este token los endpoints devuelven 503 y no se revela configuración.
UPDATE_TOKEN=

# --- Docker distribuido (agente por workstation) ---
# La API central no ejecuta docker: enruta al agente de `workstationId`.
# `local` es el modo legado, solo para desarrollo en un único host.
RUNLABQA_DOCKER_TRANSPORT=agent
# Token compartido con los agentes. Sin él, la API rechaza su conexión.
RUNLABQA_AGENT_TOKEN=

# --- Datos previos a la dockerización (bind mounts de la API) ---
# Perfiles que ya existían antes del cambio: index.json, configs, entornos,
# schedules y reportes. Se montan en /data/profiles dentro del contenedor.
RUNLABQA_PROFILES_DIR=../runlab-agrimpex-api/profiles
# Kit Playwright. Se monta en la MISMA ruta absoluta que aparece como
# `projectPath` en los perfiles; cámbialo solo si actualizas esa config.
PLAYWRIGHT_KIT_DIR=/home/potlitel/Trabajo/EICMA/Agrimpex/playwright-kit-profesional

# --- Configuración central del stack (montajes compartidos) ---
# Directorio que contiene este .env; la API solo puede escribir aquí el .env
# y public/public-config.json. Las copias van a /data/config-backups.
RUNLABQA_STACK_DIR=.
RUNLABQA_PUBLIC_CONFIG_FILE=./public/public-config.json

# --- Proxy corporativo (solo si el build necesita salir a Internet) ---
# HTTP_PROXY=http://172.16.65.61:3128
# HTTPS_PROXY=http://172.16.65.61:3128
# NO_PROXY=localhost,127.0.0.1,::1
