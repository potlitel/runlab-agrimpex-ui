# Fase de construcción - versión optimizada
FROM node:22-alpine AS build

# Configurar proxy con timeout más largo
ENV HTTP_PROXY=http://172.16.65.61:3128
ENV HTTPS_PROXY=http://172.16.65.61:3128
ENV NO_PROXY=localhost,127.0.0.1,::1
ENV NODE_ENV=production

WORKDIR /app

# Copiar solo package.json para instalar dependencias
COPY package.json ./

# Instalar dependencias con timeout más largo y retry
RUN yarn install --frozen-lockfile --network-timeout 1200000 --check-files --force

# Copiar el resto del código
COPY . .

# Construir la aplicación (sin TypeScript check, ya que ya fue corregido)
RUN yarn build

# Fase de ejecución
FROM node:22-alpine AS runner

WORKDIR /app

# Configurar proxy
ENV HTTP_PROXY=http://172.16.65.61:3128
ENV HTTPS_PROXY=http://172.16.65.61:3128
ENV NO_PROXY=localhost,127.0.0.1,::1

# Instalar serve para servir archivos estáticos
RUN npm install -g serve

# Copiar archivos construidos
COPY --from=build /app/dist ./dist

# Exponer puerto
EXPOSE 3000

# Servir archivos estáticos
CMD ["serve", "-s", "dist", "-l", "3000"]