# Fase de construcción con proxy configurado
FROM node:22-alpine AS build

# Configurar proxy si es necesario (ajustar según tu proxy)
ENV HTTP_PROXY=http://proxyempresa:8080
ENV HTTPS_PROXY=http://proxyempresa:8080
ENV NO_PROXY=localhost,127.0.0.1,::1

WORKDIR /app

# Copiar solo package.json y yarn.lock
COPY DAM.Frontend.React/package.json DAM.Frontend.React/yarn.lock ./

# Instalar dependencias con yarn
RUN yarn install --frozen-lockfile

# Copiar el resto del código
COPY DAM.Frontend.React/ .

# Construir la aplicación
RUN yarn build

# Fase de ejecución con Nginx
FROM nginx:alpine

# Copiar los archivos construidos
COPY --from=build /app/dist /usr/share/nginx/html

# Configuración de Nginx para SPA
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]