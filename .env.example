# =====================================================================
#  Plantilla de variables del frontend (Vite)
# =====================================================================
#  En DESARROLLO local (npm run dev) no hace falta definir nada: Vite
#  hace proxy de /api y /socket.io hacia http://localhost:3001.
#
#  En DOCKER / build de producción, Vite hornea estas variables en el
#  bundle: deben ser alcanzables DESDE EL NAVEGADOR (no desde el
#  contenedor). Cambiarlas exige reconstruir la imagen del frontend.
# =====================================================================

# URL base de la API REST.
# - Docker local:  http://localhost:3001/api
# - Servidor remoto: http://<IP-del-servidor>:3001/api
VITE_API_URL=http://localhost:3001/api

# Origen del canal Socket.io. Opcional: si se omite se deriva de
# VITE_API_URL (http://<host>:<puerto>) y en desarrollo usa el mismo
# origen del página.
VITE_SOCKET_URL=http://localhost:3001
