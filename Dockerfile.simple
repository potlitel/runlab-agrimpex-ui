# Usamos la imagen base de Node.js
FROM node:22-alpine
WORKDIR /app

# Copiamos package.json y package-lock.json del frontend
COPY DAM.Frontend.React/package*.json ./

# Instalamos todas las dependencias (incluyendo dev para build)
RUN yarn install

# Copiamos el resto del código de la aplicación frontend
COPY DAM.Frontend.React/ .

# Intentamos ejecutar la aplicación en modo de desarrollo (para diagnóstico)
# Nota: Esto es para diagnóstico, no es ideal para producción.
RUN yarn build

# Si el modo de desarrollo falla, se podría intentar la construcción de producción de nuevo
# después de resolver los errores de TypeScript.
# RUN npm run build --legacy-peer-deps
# EXPOSE 4173
# CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0"]